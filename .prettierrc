{
  "parser": "babel",
  "singleQuote": true,
  "trailingComma": "all",
  "tabWidth": 4,
  "semi": false,
  "printWidth": 80,
  "arrowParens": "avoid",
  "bracketSameLine": true,
  "endOfLine": "auto",
  "htmlWhitespaceSensitivity": "ignore",
  "jsxSingleQuote": true,
  "quoteProps": "as-needed",
  "useTabs": false,
  "proseWrap": "preserve",
  "plugins": ["prettier-plugin-tailwindcss"],
  "pluginSearchDirs": false
}
